# ============================================================
# 配置说明
# ------------------------------------------------------------
# 1. 生效优先级（高 → 低）：
#      进程内传入 > OS 环境变量 > 本文件(.env) > 代码默认值(core/config.py)
#    因此本文件不落盘任何真密钥，敏感项一律从 OS 环境变量注入。
#
# 2. 本文件支持 POSIX 变量插值（由 python-dotenv 解析）：
#      ${VAR}           引用 OS 环境变量；未设置则解析为空字符串
#      ${VAR:-默认值}   引用 OS 环境变量；未设置则使用「默认值」  ← 推荐
#    注意：写成 ${VAR} 而不给默认值时，会静默把代码里的默认值顶掉变成空串，
#          所以要么写 :-默认值，要么直接删掉这一行。
#
# 3. 同一变量名不要在本文件里重复定义。
#
# 4. 用法：
#      cp .env.example .env
#      export LLM_API_KEY=sk-xxx
#      export EMBEDDING_API_KEY=sk-yyy
# ============================================================

# ---- 应用 ----
APP_ENV=${APP_ENV:-dev}
LOG_LEVEL=${LOG_LEVEL:-INFO}

# ---- LLM（OpenAI 兼容协议）----
LLM_BASE_URL=${LLM_BASE_URL:-https://api.agicto.cn/v1/}
LLM_API_KEY=${LLM_API_KEY:-}
LLM_MODEL=${LLM_MODEL:-deepseek-chat}
LLM_FALLBACK_MODEL=${LLM_FALLBACK_MODEL:-deepseek-chat}
LLM_TIMEOUT=${LLM_TIMEOUT:-30}
LLM_MAX_RETRIES=${LLM_MAX_RETRIES:-2}

# ---- Embedding（OpenAI 兼容协议）----
EMBEDDING_BASE_URL=${EMBEDDING_BASE_URL:-https://api.siliconflow.cn/v1}
EMBEDDING_API_KEY=${EMBEDDING_API_KEY:-}
EMBEDDING_MODEL=${EMBEDDING_MODEL:-BAAI/bge-m3}
EMBEDDING_DIM=${EMBEDDING_DIM:-1024}

# ---- Rerank：none | http ----
RERANK_PROVIDER=${RERANK_PROVIDER:-none}
RERANK_BASE_URL=${RERANK_BASE_URL:-https://api.siliconflow.cn/v1}
RERANK_API_KEY=${RERANK_API_KEY:-}
RERANK_MODEL=${RERANK_MODEL:-BAAI/bge-reranker-v2-m3}

# ---- 联网搜索：none | tavily | serper ----
WEB_SEARCH_PROVIDER=${WEB_SEARCH_PROVIDER:-none}
WEB_SEARCH_API_KEY=${WEB_SEARCH_API_KEY:-}

# ---- PostgreSQL + pgvector ----
POSTGRES_HOST=${POSTGRES_HOST:-localhost}
POSTGRES_PORT=${POSTGRES_PORT:-5432}
POSTGRES_USER=${POSTGRES_USER:-smartqa}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-smartqa}
POSTGRES_DB=${POSTGRES_DB:-smartqa}

# ---- Redis ----
REDIS_URL=${REDIS_URL:-redis://localhost:6379/0}

# ---- 鉴权 ----
# 生产环境必须修改，且务必从 OS 环境变量注入
JWT_SECRET=${JWT_SECRET:-change-me-please}
JWT_TTL_HOURS=${JWT_TTL_HOURS:-12}
DEFAULT_ADMIN_USERNAME=${DEFAULT_ADMIN_USERNAME:-admin}
DEFAULT_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD:-admin123}

# ---- 可观测（留空则 no-op）----
LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY:-}
LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY:-}
LANGFUSE_HOST=${LANGFUSE_HOST:-https://cloud.langfuse.com}

# ---- 工具安全 ----
# 允许 Agent 调用的工具白名单（逗号分隔）
AGENT_ALLOWED_TOOLS=${AGENT_ALLOWED_TOOLS:-kb_search,web_search,calculator,db_query}
# db_query 仅允许查询的只读视图（逗号分隔，空表示禁用该工具）
DB_READONLY_VIEWS=${DB_READONLY_VIEWS:-v_employee_stats}
