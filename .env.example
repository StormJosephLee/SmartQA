# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- LLM（OpenAI 兼容协议）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ---- Embedding（OpenAI 兼容协议）----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Rerank：none | http ----
RERANK_PROVIDER=none
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxxxxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 联网搜索：none | tavily | serper ----
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=

# ---- PostgreSQL + pgvector ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartqa
POSTGRES_PASSWORD=smartqa
POSTGRES_DB=smartqa

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
JWT_SECRET=change-me-please
JWT_TTL_HOURS=12
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---- 可观测（留空则 no-op）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 工具安全 ----
# 允许 Agent 调用的工具白名单（逗号分隔）
AGENT_ALLOWED_TOOLS=kb_search,web_search,calculator,db_query
# db_query 仅允许查询的只读视图（逗号分隔，空表示禁用该工具）
DB_READONLY_VIEWS=v_employee_stats
